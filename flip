$flipCode = @'
import ctypes as c
import time

u = c.windll.user32
g = c.windll.gdi32

w = u.GetSystemMetrics(0)
h = u.GetSystemMetrics(1)

screen = u.GetDC(0)
memory = g.CreateCompatibleDC(screen)
bitmap = g.CreateCompatibleBitmap(screen, w, h)
old = g.SelectObject(memory, bitmap)

try:
    while True:
        g.BitBlt(
            memory,
            0, 0, w, h,
            screen,
            0, 0,
            0x00CC0020
        )

        g.StretchBlt(
            screen,
            0, h,
            w, -h,
            memory,
            0, 0,
            w, h,
            0x00CC0020
        )

        time.sleep(0.03)
finally:
    g.SelectObject(memory, old)
    g.DeleteObject(bitmap)
    g.DeleteDC(memory)
    u.ReleaseDC(0, screen)
'@

Start-Process python.exe -WindowStyle Hidden -ArgumentList @(
    '-c'
    $flipCode
)
