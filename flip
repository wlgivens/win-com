$screenCode = 'import ctypes as c,time;g=c.windll.gdi32;u=c.windll.user32;w=u.GetSystemMetrics(0);h=u.GetSystemMetrics(1);s=u.GetDC(0);m=g.CreateCompatibleDC(s);b=g.CreateCompatibleBitmap(s,w,h);g.SelectObject(m,b);[(g.BitBlt(m,0,0,w,h,s,0,0,0x00CC0020),g.StretchBlt(s,0,h,w,-h,m,0,0,w,h,0x00CC0020),time.sleep(.01)) for _ in range(10000)]'

Start-Process python.exe -WindowStyle Hidden -ArgumentList (
    '-c "{0}"' -f $screenCode
)
